root = true

[*.cs]
# sem esta linha o dotnet build ignora o severity das regras abaixo
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.metodos_em_pascal.symbols = metodos
dotnet_naming_rule.metodos_em_pascal.style = pascal
dotnet_naming_rule.metodos_em_pascal.severity = warning
dotnet_naming_symbols.metodos.applicable_kinds = method, local_function
dotnet_naming_symbols.metodos.applicable_accessibilities = *
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.locais_em_camel.symbols = locais
dotnet_naming_rule.locais_em_camel.style = camel
dotnet_naming_rule.locais_em_camel.severity = warning
dotnet_naming_symbols.locais.applicable_kinds = local
dotnet_naming_style.camel.capitalization = camel_case
